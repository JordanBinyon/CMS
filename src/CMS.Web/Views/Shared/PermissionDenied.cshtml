@{
    ViewData["Title"] = "Home Page";
    Layout = "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SpireLabs</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #0f0f0f, #1e1e1e);
            height: 100vh;
            overflow: hidden;
            color: #fff;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        .main-title {
            font-size: 5em;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 5px;
            opacity: 0;
            animation: fadeInUp 1.5s ease forwards 0.5s;
        }
        .subtitle {
            font-size: 1.2em;
            margin-top: 20px;
            opacity: 0;
            animation: fadeInUp 1.5s ease forwards 1s;
        }
        footer {
            position: absolute;
            bottom: 20px;
            font-size: 0.9em;
            color: #aaa;
            animation: fadeIn 2s ease forwards 1.5s;
        }
        /* Animations */
        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(50px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        /* Particle Background */
        #particles {
            position: absolute;
            width: 100%;
            height: 100%;
            z-index: -1;
        }
    </style>
</head>
<body>
<div id="particles"></div>
<h1 class="main-title">PERMISSION DENIED</h1>
<footer>© 2025 SpireLabs</footer>

<script>
    // Particle animation
    function createParticle() {
        const particle = document.createElement('div');
        particle.style.position = 'absolute';
        particle.style.width = '2px';
        particle.style.height = '2px';
        particle.style.background = 'rgba(255, 255, 255, 0.5)';
        particle.style.borderRadius = '50%';
        particle.style.left = Math.random() * 100 + 'vw';
        particle.style.top = Math.random() * 100 + 'vh';
        particle.style.animation = `float ${Math.random() * 5 + 2}s infinite`;
        document.getElementById('particles').appendChild(particle);

        setTimeout(() => particle.remove(), 5000);
    }
    setInterval(createParticle, 200);

    // Float animation for particles
    const styleSheet = document.createElement('style');
    styleSheet.textContent = `
            @@keyframes float {
                0% { transform: translateY(0); opacity: 1; }
                100% { transform: translateY(-50vh); opacity: 0; }
            }
        `;
    document.head.appendChild(styleSheet);
</script>
</body>
</html>