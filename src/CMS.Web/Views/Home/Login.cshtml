@{
    Layout = "";
}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Login</title>
        <link rel="stylesheet" href="~/css/login.css" asp-append-version="true"/>
    </head>
    <body>
        <div class="login">
            <h2 class="login__title">Login</h2>
            <form class="login__form">
                <input class="login__input" type="text" placeholder="Username" required>
                <input class="login__input" type="password" placeholder="Password" required>
                <button class="login__button" type="submit">Sign In</button>
            </form>
            <p class="login__footer"><a href="#" class="login__link">Forgot Password?</a></p>
        </div>
    </body>
</html>