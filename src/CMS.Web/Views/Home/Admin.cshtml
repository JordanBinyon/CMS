@{
    ViewData["Title"] = "Admin";
    Layout = "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CMS Admin Panel</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        .body {
            background: #f0f2f5;
            color: #333;
            overflow-x: hidden;
        }

        /* Top Navigation */
        .top-nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 60px;
            background: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            z-index: 1000;
        }

        .top-nav__logo {
            font-size: 24px;
            font-weight: bold;
            color: #2c3e50;
        }

        .top-nav__mobile-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
            color: #2c3e50;
        }

        .top-nav__user-menu {
            position: relative;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .top-nav__profile {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            color: #666;
            font-weight: 500;
            text-decoration: none;
            position: relative;
        }

        .top-nav__profile::before {
            content: '▼';
            font-size: 12px;
            color: #666;
            margin-right: 8px;
        }

        .top-nav__profile-img {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #ccc;
            order: 1;
        }

        .top-nav__dropdown {
            position: absolute;
            top: 100%;
            right: 0;
            background: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            display: none;
            flex-direction: column;
            width: max-content;
        }

        .top-nav__user-menu:hover .top-nav__dropdown {
            display: flex;
        }

        .top-nav__dropdown-item {
            padding: 8px 15px;
            text-decoration: none;
            color: #666;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
            white-space: nowrap;
        }

        .top-nav__dropdown-item:hover {
            background: #f0f2f5;
        }

        .top-nav__dropdown-icon {
            min-width: 20px;
        }

        /* Sidebar */
        .sidebar {
            position: fixed;
            top: 60px;
            left: 0;
            width: 250px;
            height: calc(100vh - 60px);
            background: #2c3e50;
            color: #fff;
            transition: width 0.3s ease, left 0.3s ease;
            overflow-y: auto;
            box-sizing: border-box;
            z-index: 900;
            display: flex;
            flex-direction: column;
        }

        .sidebar--collapsed {
            width: 70px;
        }

        .sidebar__toggle-btn {
            width: 100%;
            padding: 15px;
            background: #34495e;
            border: none;
            color: #fff;
            font-size: 18px;
            cursor: pointer;
            text-align: left;
        }

        .sidebar__menu {
            list-style: none;
            padding: 10px 0;
            flex-grow: 1;
        }

        .sidebar__menu-item {
            padding: 15px 20px;
            position: relative;
        }

        .sidebar__menu-link {
            color: #fff;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .sidebar__menu-item:hover {
            background: #34495e;
        }

        .sidebar--collapsed .sidebar__menu-link span:not(.sidebar__menu-icon) {
            display: none;
        }

        .sidebar__menu-icon {
            min-width: 20px;
        }

        .sidebar__menu-item--profile {
            display: none; /* Hidden by default, shown on mobile */
        }

        .sidebar__menu-link--profile {
            display: flex;
            align-items: center;
        }

        .sidebar__menu-link--profile::after {
            content: '▼';
            color: #fff;
            font-size: 12px;
            margin-left: auto;
        }

        .sidebar--collapsed .sidebar__menu-link--profile::after {
            content: none; /* Hide ▼ when collapsed */
        }

        .sidebar__menu-link--profile-img {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #ccc;
            margin-right: 8px;
        }

        .sidebar__menu-link--username {
            /* No extra styling needed, stays left with image */
        }

        .sidebar__menu-link--users {
            display: flex;
            align-items: center;
        }

        .sidebar__menu-link--users::after {
            content: '▼';
            color: #fff;
            font-size: 12px;
            margin-left: auto;
        }

        .sidebar--collapsed .sidebar__menu-link--users::after {
            content: none; /* Hide ▼ when collapsed */
        }

        .sidebar__submenu {
            list-style: none;
            display: none;
            background: #34495e;
            padding: 0;
            margin: 0;
        }

        .sidebar:not(.sidebar--collapsed) .sidebar__menu-item--profile:hover .sidebar__submenu,
        .sidebar:not(.sidebar--collapsed) .sidebar__menu-item--profile--active .sidebar__submenu,
        .sidebar:not(.sidebar--collapsed) .sidebar__menu-item--users:hover .sidebar__submenu,
        .sidebar:not(.sidebar--collapsed) .sidebar__menu-item--users--active .sidebar__submenu {
            display: block; /* Only show when sidebar is not collapsed */
        }

        .sidebar__submenu-item {
            padding: 15px 20px;
        }

        .sidebar__submenu-link {
            color: #fff;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .sidebar__submenu-item:hover {
            background: #3e5c76;
        }

        .sidebar__logout {
            position: sticky;
            bottom: 0;
            width: 100%;
            background: #2c3e50;
        }

        .sidebar__logout-separator {
            height: 1px;
            background: #5e7790;
            margin: 0 20px;
        }

        .sidebar__logout-btn {
            width: 100%;
            padding: 15px 20px;
            background: none;
            border: none;
            color: #fff;
            font-size: 16px;
            cursor: pointer;
            text-align: left;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .sidebar__logout-btn:hover {
            background: #34495e;
        }

        .sidebar--collapsed .sidebar__logout-btn span:not(.sidebar__menu-icon) {
            display: none;
        }

        /* Main Container */
        .main-container {
            margin-top: 60px;
            margin-left: 250px;
            transition: margin-left 0.3s ease;
            display: flex;
        }

        .main-container--expanded {
            margin-left: 70px;
        }

        .main-container__content {
            background: #fff;
            flex: 1;
            margin: 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 36px;
            color: #2c3e50;
            font-weight: bold;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
        .top-nav {
            justify-content: center;
        }

        .top-nav__mobile-toggle {
            display: block;
            position: absolute;
            left: 20px;
        }

        .top-nav__user-menu {
            display: none;
        }

        .sidebar {
            width: 250px;
            left: -250px;
        }

        .sidebar--mobile-open {
            left: 0;
        }

        .sidebar--mobile-open .sidebar__toggle-btn {
            display: none;
        }

        .sidebar--collapsed {
            width: 0;
        }

        .sidebar__menu-item--profile {
            display: block;
        }

        .main-container {
            margin-left: 0;
        }

        .main-container--expanded {
            margin-left: 0;
        }
        }
    </style>
</head>
<body class="body">
<!-- Top Navigation -->
<nav class="top-nav">
    <button class="top-nav__mobile-toggle" onclick="toggleMobileSidebar()">☰</button>
    <div class="top-nav__logo">CMS Admin</div>
    <div class="top-nav__user-menu">
        <a href="#" class="top-nav__profile">
            <span>Profile</span>
            <div class="top-nav__profile-img"></div>
        </a>
        <div class="top-nav__dropdown">
            <a href="#" class="top-nav__dropdown-item">
                <span class="top-nav__dropdown-icon">📊</span>
                <span>Placeholder 1</span>
            </a>
            <a href="#" class="top-nav__dropdown-item">
                <span class="top-nav__dropdown-icon">📋</span>
                <span>Placeholder 2</span>
            </a>
            <a href="#" class="top-nav__dropdown-item">
                <span class="top-nav__dropdown-icon">🔧</span>
                <span>Placeholder 3</span>
            </a>
            <a href="#" class="top-nav__dropdown-item">
                <span class="top-nav__dropdown-icon">🚪</span>
                <span>Logout</span>
            </a>
        </div>
    </div>
</nav>

<!-- Sidebar -->
<aside class="sidebar">
    <button class="sidebar__toggle-btn" onclick="toggleSidebar()">☰</button>
    <ul class="sidebar__menu">
        <li class="sidebar__menu-item sidebar__menu-item--profile">
            <a href="#" class="sidebar__menu-link sidebar__menu-link--profile" onclick="toggleSubmenu(event, 'profile')">
                <div class="sidebar__menu-link--profile-img"></div>
                <span class="sidebar__menu-link--username">John Doe</span>
            </a>
            <ul class="sidebar__submenu">
                <li class="sidebar__submenu-item">
                    <a href="#" class="sidebar__submenu-link">
                        <span class="sidebar__menu-icon">📊</span>
                        <span>Placeholder 1</span>
                    </a>
                </li>
                <li class="sidebar__submenu-item">
                    <a href="#" class="sidebar__submenu-link">
                        <span class="sidebar__menu-icon">📋</span>
                        <span>Placeholder 2</span>
                    </a>
                </li>
                <li class="sidebar__submenu-item">
                    <a href="#" class="sidebar__submenu-link">
                        <span class="sidebar__menu-icon">🔧</span>
                        <span>Placeholder 3</span>
                    </a>
                </li>
            </ul>
        </li>
        <li class="sidebar__menu-item">
            <a href="#" class="sidebar__menu-link">
                <span class="sidebar__menu-icon">🏠</span>
                <span>Dashboard</span>
            </a>
        </li>
        <li class="sidebar__menu-item">
            <a href="#" class="sidebar__menu-link">
                <span class="sidebar__menu-icon">📝</span>
                <span>Content</span>
            </a>
        </li>
        <li class="sidebar__menu-item sidebar__menu-item--users">
            <a href="#" class="sidebar__menu-link sidebar__menu-link--users" onclick="toggleSubmenu(event, 'users')">
                <span class="sidebar__menu-icon">👥</span>
                <span>Users</span>
            </a>
            <ul class="sidebar__submenu">
                <li class="sidebar__submenu-item">
                    <a href="#" class="sidebar__submenu-link">
                        <span class="sidebar__menu-icon">👤</span>
                        <span>User List</span>
                    </a>
                </li>
                <li class="sidebar__submenu-item">
                    <a href="#" class="sidebar__submenu-link">
                        <span class="sidebar__menu-icon">➕</span>
                        <span>Add User</span>
                    </a>
                </li>
                <li class="sidebar__submenu-item">
                    <a href="#" class="sidebar__submenu-link">
                        <span class="sidebar__menu-icon">🔍</span>
                        <span>Search Users</span>
                    </a>
                </li>
            </ul>
        </li>
        <li class="sidebar__menu-item">
            <a href="#" class="sidebar__menu-link">
                <span class="sidebar__menu-icon">⚙️</span>
                <span>Settings</span>
            </a>
        </li>
    </ul>
    <div class="sidebar__logout">
        <div class="sidebar__logout-separator"></div>
        <button class="sidebar__logout-btn">
            <span class="sidebar__menu-icon">🚪</span>
            <span>Logout</span>
        </button>
    </div>
</aside>

<!-- Main Container -->
<main class="main-container">
    <div class="main-container__content">
        SpireLabs
    </div>
</main>

<script>
    function toggleSidebar() {
        const sidebar = document.querySelector('.sidebar');
        const mainContainer = document.querySelector('.main-container');
        const isMobile = window.innerWidth <= 768;

        if (!isMobile) {
            sidebar.classList.toggle('sidebar--collapsed');
            mainContainer.classList.toggle('main-container--expanded');
            sidebar.classList.remove('sidebar--mobile-open');
        }
    }

    function toggleMobileSidebar() {
        const sidebar = document.querySelector('.sidebar');
        const isMobile = window.innerWidth <= 768;

        if (isMobile) {
            sidebar.classList.toggle('sidebar--mobile-open');
            sidebar.classList.remove('sidebar--collapsed');
        }
    }

    function toggleSubmenu(event, type) {
        event.preventDefault();
        const isMobile = window.innerWidth <= 768;
        let menuItem;

        if (type === 'profile') {
            menuItem = document.querySelector('.sidebar__menu-item--profile');
        } else if (type === 'users') {
            menuItem = document.querySelector('.sidebar__menu-item--users');
        }

        if (menuItem && (isMobile || type === 'users') && !document.querySelector('.sidebar').classList.contains('sidebar--collapsed')) {
            menuItem.classList.toggle(type === 'profile' ? 'sidebar__menu-item--profile--active' : 'sidebar__menu-item--users--active');
        }
    }
</script>
</body>
</html>